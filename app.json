{
  "expo": {
    "name": "MealScanner",
    "slug": "mealscanner-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mealscanner",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/ios-icon.jpg",
      "supportsTablet": true,
      "bundleIdentifier": "app.mealscanner",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "MealScanner needs access to your camera to scan and analyze meal images for nutritional information.",
        "NSPhotoLibraryUsageDescription": "MealScanner needs access to your photo library to select meal images for nutritional analysis.",
        "NSMicrophoneUsageDescription": "MealScanner needs access to your microphone for voice input to describe meals.",
        "NSFaceIDUsageDescription": "MealScanner uses Face ID to securely authenticate and protect your account information.",
        "NSHealthShareUsageDescription": "MealScanner reads your active energy and steps to adjust your daily nutrition targets.",
        "NSHealthUpdateUsageDescription": "MealScanner logs your meal calories and macros to your Apple Health history."
      },
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#143c23"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "package": "app.mealscanner"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#143c23"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone for voice input."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosClientId": "406558558947-m8fffoskmmsicsj413t625h1tps031ei.apps.googleusercontent.com",
          "iosUrlScheme": "com.googleusercontent.apps.406558558947-m8fffoskmmsicsj413t625h1tps031ei"
        }
      ],
      "expo-apple-authentication",
      "@kingstinct/react-native-healthkit"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6670b9f1-d3f7-46f4-a488-d1fa4f491e40"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/6670b9f1-d3f7-46f4-a488-d1fa4f491e40"
    }
  }
}
